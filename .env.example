# Copie para .env.local e ajuste. Nada aqui é segredo: tudo que começa com
# VITE_ vai parar no código do navegador.

# false -> fala com a API do Django (padrão)
# true  -> usa login e cadastro simulados (só a autenticação; o resto das telas
#          consulta a API real e precisa de uma sessão real)
VITE_API_MOCK=false

# Para onde o Vite repassa /api em desenvolvimento. Como o navegador só vê o
# próprio servidor do Vite, não há CORS em dev. Para usar a API publicada:
#   VITE_API_PROXY_TARGET=https://twist-api.onrender.com
# Para usar o Django local:
#   VITE_API_PROXY_TARGET=http://localhost:8000
VITE_API_PROXY_TARGET=https://twist-api.onrender.com

# Base da API no build de produção. Vazio = /api no mesmo domínio (a hospedagem
# precisa repassar /api para o back). Se apontar direto para o back, inclua o
# /api no fim e o back precisa liberar CORS para o domínio do front:
#   VITE_API_URL=https://twist-api.onrender.com/api
VITE_API_URL=

# Funcionalidades em espera.
VITE_FEATURE_SERIES=false
