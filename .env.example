# Copie para .env.local e ajuste. Nada aqui é segredo: tudo que começa com
# VITE_ vai parar no código do navegador.

# true  -> usa dados e login simulados (não precisa do back-end rodando)
# false -> fala com a API do Django
VITE_API_MOCK=true

# Para onde o Vite repassa /api em desenvolvimento (servidor do Django).
VITE_API_PROXY_TARGET=http://localhost:8000

# Base da API no build de produção. Vazio = /api no mesmo domínio.
VITE_API_URL=

# Funcionalidades em espera.
VITE_FEATURE_SERIES=false
